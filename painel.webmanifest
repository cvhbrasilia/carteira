{
  "name": "Painel da Carteira CVH",
  "short_name": "Painel CVH",
  "start_url": "painel.html",
  "display": "standalone",
  "background_color": "#F5EFE7",
  "theme_color": "#F5EFE7",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "painel-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "painel-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "painel-maskable-512.png?v=5",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
